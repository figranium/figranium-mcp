{
  "name": "figranium-mcp",
  "version": "1.0.0",
  "description": "MCP server for Figranium, wrapping task execution, scheduling, and automation orchestration.",
  "main": "dist/index.js",
  "bin": {
    "figranium-mcp": "dist/index.js"
  },
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "postbuild": "node -e \"require('fs').chmodSync('./dist/index.js', 0o755)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "axios": "^1.6.8",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
