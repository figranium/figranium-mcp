{
  "name": "figranium-mcp",
  "version": "1.4.0",
  "mcpName": "io.github.figranium/figranium-mcp",
  "description": "MCP server for Figranium, wrapping task execution, scheduling, and automation orchestration.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figranium/figranium-mcp.git"
  },
  "main": "dist/index.js",
  "bin": {
    "figranium-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "tsc && cp api-home.html dist/index.html",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "postbuild": "node -e \"require('fs').chmodSync('./dist/index.js', 0o755)\""
  },
  "dependencies": {
    "@figranium/sdk": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0"
  }
}
